{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "peakslocal.com" }],
      "destination": "https://www.peakslocal.com/$1",
      "permanent": true
    },
    { "source": "/team", "destination": "/about", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/our-team", "destination": "/about", "permanent": true }
  ],
  "rewrites": [{ "source": "/((?!api/|sitemap\\.xml|robots\\.txt).*)", "destination": "/index.html" }]
}
